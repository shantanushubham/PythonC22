{
  "openapi": "3.1.0",
  "info": {
    "title": "UPI Payment Service",
    "version": "1.0.0",
    "description": "Mock UPI service for the AirPay payment gateway.\n\nStart a payment with a payer's VPA (for example `jane.doe@okaxis`) and the service sends a\ncollect request, like a real UPI app would. Nothing reaches a real bank. Payments are saved\nto a local SQLite file, so they survive restarts.\n\n### Lifecycle\nUPI is asynchronous. `POST /api/v1/payments` returns `PENDING`. After a short delay\n(the payer \"approving\" in their app) the payment becomes `SUCCESS`, `FAILED`, or\n`EXPIRED`. Poll `GET /api/v1/payments/{transaction_id}`. The `Retry-After` header says\nwhen to ask again.\n\n### Mock scenarios\nA keyword inside the **payer VPA name** picks the result. A VPA with no keyword succeeds.\n\n| Keyword in VPA name | Result |\n| --- | --- |\n| `notfound` | Rejected at once with `400`, as the VPA does not exist |\n| `insufficient` | `FAILED`, `INSUFFICIENT_FUNDS` |\n| `declined` | `FAILED`, `PAYER_DECLINED` |\n| `pinfail` | `FAILED`, `INCORRECT_PIN` |\n| `bankdown` | `FAILED`, `BANK_UNAVAILABLE` |\n| `blocked` | `FAILED`, `VPA_BLOCKED` |\n| `expired` | `EXPIRED`, only once the collect request times out |\n\nAmounts above the transaction limit (Rs 1,00,000 by default) fail with `LIMIT_EXCEEDED`.\n"
  },
  "servers": [
    {
      "url": "http://localhost:8003",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "payments",
      "description": "Start and track UPI payments."
    },
    {
      "name": "vpa",
      "description": "Check that a VPA exists."
    },
    {
      "name": "health",
      "description": "Service liveness."
    }
  ],
  "components": {
    "schemas": {
      "PaymentResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "True when the call worked and `data` describes the payment. Read `data.status` for the outcome."
          },
          "data": {
            "$ref": "#/components/schemas/PaymentResource"
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "PaymentResource": {
        "type": "object",
        "properties": {
          "transaction_id": {
            "type": "string",
            "example": "txn_bd87dbbb-c490-42eb-9ba4-a5dd0954f944"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "SUCCESS",
              "FAILED",
              "EXPIRED"
            ],
            "description": "PENDING until the payer responds, then SUCCESS, FAILED, or EXPIRED. Only PENDING can change."
          },
          "amount": {
            "type": "string",
            "example": "1500.50"
          },
          "currency": {
            "type": "string",
            "enum": [
              "INR"
            ]
          },
          "payer": {
            "$ref": "#/components/schemas/Party"
          },
          "payee": {
            "$ref": "#/components/schemas/Party"
          },
          "rrn": {
            "type": "string",
            "description": "12-digit retrieval reference number banks use for the UPI transaction.",
            "example": "907497627294"
          },
          "description": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "failure_code": {
            "type": "string",
            "enum": [
              "INSUFFICIENT_FUNDS",
              "PAYER_DECLINED",
              "INCORRECT_PIN",
              "LIMIT_EXCEEDED",
              "BANK_UNAVAILABLE",
              "VPA_BLOCKED",
              "COLLECT_EXPIRED"
            ],
            "description": "Machine-readable reason. Present when status is FAILED or EXPIRED."
          },
          "failure_reason": {
            "type": "string",
            "example": "Insufficient funds"
          },
          "created_at": {
            "type": "string",
            "example": "2026-10-18T12:13:18.486Z"
          },
          "expires_at": {
            "type": "string",
            "description": "When the collect request stops being valid if the payer has not responded.",
            "example": "2026-10-18T12:18:18.486Z"
          },
          "completed_at": {
            "type": "string",
            "description": "When the payer responded. Absent while PENDING.",
            "example": "2026-10-18T12:13:21.486Z"
          }
        },
        "required": [
          "transaction_id",
          "status",
          "amount",
          "currency",
          "payer",
          "payee",
          "rrn",
          "created_at",
          "expires_at"
        ]
      },
      "Party": {
        "type": "object",
        "properties": {
          "vpa": {
            "type": "string",
            "example": "jane.doe@okaxis"
          },
          "name": {
            "type": "string",
            "example": "Jane Doe"
          }
        },
        "required": [
          "vpa",
          "name"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        },
        "required": [
          "success",
          "message"
        ]
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ]
      },
      "CreatePaymentRequest": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "string",
            "description": "Amount in rupees with at most 2 decimal places. A string (\"1500.50\") or a JSON number is accepted.",
            "example": "1500.50"
          },
          "currency": {
            "type": "string",
            "enum": [
              "INR"
            ],
            "default": "INR"
          },
          "payer_vpa": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,49}@[a-z][a-z0-9]{1,29}$",
            "description": "The VPA the collect request is sent to. Upper case is accepted and stored in lower case.",
            "example": "jane.doe@okaxis"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^[^\\u0000-\\u001f]+$",
            "description": "Note shown to the payer in their UPI app.",
            "example": "Order 1001"
          },
          "reference": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Your own id for this payment, such as an order id.",
            "example": "order_1001"
          }
        },
        "required": [
          "amount",
          "payer_vpa"
        ],
        "additionalProperties": false
      },
      "VpaValidationResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "$ref": "#/components/schemas/VpaValidation"
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "VpaValidation": {
        "type": "object",
        "properties": {
          "vpa": {
            "type": "string",
            "example": "jane.doe@okaxis"
          },
          "valid": {
            "type": "boolean"
          },
          "account_holder_name": {
            "type": "string",
            "example": "Jane Doe"
          },
          "bank_name": {
            "type": "string",
            "example": "Axis Bank"
          },
          "reason": {
            "type": "string",
            "description": "Why the VPA cannot be used. Present when `valid` is false.",
            "example": "VPA does not exist"
          }
        },
        "required": [
          "vpa",
          "valid"
        ]
      },
      "ValidateVpaRequest": {
        "type": "object",
        "properties": {
          "vpa": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,49}@[a-z][a-z0-9]{1,29}$",
            "description": "The VPA to check. Upper case is accepted and stored in lower case.",
            "example": "jane.doe@okaxis"
          }
        },
        "required": [
          "vpa"
        ],
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "enum": [
              "upi-payment-service"
            ]
          },
          "handles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "UPI handles this service accepts."
          }
        },
        "required": [
          "status",
          "service",
          "handles"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/payments": {
      "post": {
        "operationId": "createPayment",
        "tags": [
          "payments"
        ],
        "summary": "Start a UPI payment (collect request)",
        "description": "Sends a collect request to the payer's VPA and returns the payment as `PENDING`. The payer then approves or rejects it in their UPI app, which the mock simulates after a short delay. Poll `GET /api/v1/payments/{transaction_id}` to see the result.\n\nAlways `201`, even when the payment will later fail. A bad VPA or request is rejected with `400` and no payment is created. Repeating a request with the same `Idempotency-Key` returns the same payment, in its current state.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Optional. Repeating the same key and body returns the original payment instead of creating a second one. Using the same key with a different body returns `409`.",
              "example": "order-1001-attempt-1"
            },
            "required": false,
            "description": "Optional. Repeating the same key and body returns the original payment instead of creating a second one. Using the same key with a different body returns `409`.",
            "name": "Idempotency-Key",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The collect request was sent. The payment is usually `PENDING`.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "description": "Where to poll for the result.",
                  "example": "/api/v1/payments/txn_bd87dbbb-c490-42eb-9ba4-a5dd0954f944"
                },
                "required": false,
                "description": "Where to poll for the result."
              },
              "Idempotent-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ],
                  "description": "Present when this is the stored payment from an earlier request with the same Idempotency-Key."
                },
                "required": false,
                "description": "Present when this is the stored payment from an earlier request with the same Idempotency-Key."
              }
            },
            "content": {
              "application/json": {
                "examples": {
                  "pending": {
                    "summary": "Waiting for the payer",
                    "value": {
                      "success": true,
                      "data": {
                        "transaction_id": "txn_bd87dbbb-c490-42eb-9ba4-a5dd0954f944",
                        "amount": "1500.50",
                        "currency": "INR",
                        "payer": {
                          "vpa": "jane.doe@okaxis",
                          "name": "Jane Doe"
                        },
                        "payee": {
                          "vpa": "airpay@okicici",
                          "name": "AirPay Merchant"
                        },
                        "rrn": "907497627294",
                        "description": "Order 1001",
                        "reference": "order_1001",
                        "created_at": "2026-10-18T12:13:18.486Z",
                        "expires_at": "2026-10-18T12:18:18.486Z",
                        "status": "PENDING"
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request or the payer VPA was rejected. No payment is created.",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Validation failed",
                  "errors": [
                    {
                      "field": "payer_vpa",
                      "message": "VPA does not exist"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The Idempotency-Key was already used with a different body.",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Idempotency key was already used with a different request"
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Internal server error"
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payments/{transaction_id}": {
      "get": {
        "operationId": "getPayment",
        "tags": [
          "payments"
        ],
        "summary": "Get the status of a UPI payment",
        "description": "Returns the payment as it stands now. `PENDING` means the payer has not responded yet, so ask again after `Retry-After` seconds. The other statuses are final.\n\n`success` is true whenever the payment was found. Read `data.status` for the outcome.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "txn_bd87dbbb-c490-42eb-9ba4-a5dd0954f944"
            },
            "required": true,
            "name": "transaction_id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The payment, whatever its status.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string",
                  "description": "Seconds until it is worth asking again. Present while PENDING.",
                  "example": "3"
                },
                "required": false,
                "description": "Seconds until it is worth asking again. Present while PENDING."
              }
            },
            "content": {
              "application/json": {
                "examples": {
                  "pending": {
                    "summary": "Waiting for the payer",
                    "value": {
                      "success": true,
                      "data": {
                        "transaction_id": "txn_bd87dbbb-c490-42eb-9ba4-a5dd0954f944",
                        "amount": "1500.50",
                        "currency": "INR",
                        "payer": {
                          "vpa": "jane.doe@okaxis",
                          "name": "Jane Doe"
                        },
                        "payee": {
                          "vpa": "airpay@okicici",
                          "name": "AirPay Merchant"
                        },
                        "rrn": "907497627294",
                        "description": "Order 1001",
                        "reference": "order_1001",
                        "created_at": "2026-10-18T12:13:18.486Z",
                        "expires_at": "2026-10-18T12:18:18.486Z",
                        "status": "PENDING"
                      }
                    }
                  },
                  "success": {
                    "summary": "Approved",
                    "value": {
                      "success": true,
                      "data": {
                        "transaction_id": "txn_bd87dbbb-c490-42eb-9ba4-a5dd0954f944",
                        "amount": "1500.50",
                        "currency": "INR",
                        "payer": {
                          "vpa": "jane.doe@okaxis",
                          "name": "Jane Doe"
                        },
                        "payee": {
                          "vpa": "airpay@okicici",
                          "name": "AirPay Merchant"
                        },
                        "rrn": "907497627294",
                        "description": "Order 1001",
                        "reference": "order_1001",
                        "created_at": "2026-10-18T12:13:18.486Z",
                        "expires_at": "2026-10-18T12:18:18.486Z",
                        "status": "SUCCESS",
                        "completed_at": "2026-10-18T12:13:21.486Z"
                      }
                    }
                  },
                  "failed": {
                    "summary": "Declined",
                    "value": {
                      "success": true,
                      "data": {
                        "transaction_id": "txn_bd87dbbb-c490-42eb-9ba4-a5dd0954f944",
                        "amount": "1500.50",
                        "currency": "INR",
                        "payer": {
                          "vpa": "jane.doe@okaxis",
                          "name": "Jane Doe"
                        },
                        "payee": {
                          "vpa": "airpay@okicici",
                          "name": "AirPay Merchant"
                        },
                        "rrn": "907497627294",
                        "description": "Order 1001",
                        "reference": "order_1001",
                        "created_at": "2026-10-18T12:13:18.486Z",
                        "expires_at": "2026-10-18T12:18:18.486Z",
                        "status": "FAILED",
                        "failure_code": "INSUFFICIENT_FUNDS",
                        "failure_reason": "Insufficient funds",
                        "completed_at": "2026-10-18T12:13:21.486Z"
                      }
                    }
                  },
                  "expired": {
                    "summary": "Payer never responded",
                    "value": {
                      "success": true,
                      "data": {
                        "transaction_id": "txn_bd87dbbb-c490-42eb-9ba4-a5dd0954f944",
                        "amount": "1500.50",
                        "currency": "INR",
                        "payer": {
                          "vpa": "jane.doe@okaxis",
                          "name": "Jane Doe"
                        },
                        "payee": {
                          "vpa": "airpay@okicici",
                          "name": "AirPay Merchant"
                        },
                        "rrn": "907497627294",
                        "description": "Order 1001",
                        "reference": "order_1001",
                        "created_at": "2026-10-18T12:13:18.486Z",
                        "expires_at": "2026-10-18T12:18:18.486Z",
                        "status": "EXPIRED",
                        "failure_code": "COLLECT_EXPIRED",
                        "failure_reason": "Payer did not respond before the request expired",
                        "completed_at": "2026-10-18T12:18:18.486Z"
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown transaction id.",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "No payment found with id 'txn_missing'"
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Internal server error"
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/vpa-validations": {
      "post": {
        "operationId": "validateVpa",
        "tags": [
          "vpa"
        ],
        "summary": "Check that a VPA exists",
        "description": "Resolves a VPA to the account holder's name, like the check a UPI app does before you pay. A well-formed VPA that cannot be used returns `200` with `valid: false` and a `reason`. A malformed request returns `400`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateVpaRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The result of the check.",
            "content": {
              "application/json": {
                "examples": {
                  "valid": {
                    "summary": "VPA exists",
                    "value": {
                      "success": true,
                      "data": {
                        "vpa": "jane.doe@okaxis",
                        "valid": true,
                        "account_holder_name": "Jane Doe",
                        "bank_name": "Axis Bank"
                      }
                    }
                  },
                  "invalid": {
                    "summary": "VPA cannot be used",
                    "value": {
                      "success": true,
                      "data": {
                        "vpa": "ghost.notfound@okaxis",
                        "valid": false,
                        "reason": "VPA does not exist"
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/VpaValidationResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request was malformed.",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Validation failed",
                  "errors": [
                    {
                      "field": "vpa",
                      "message": "VPA must look like name@bank, for example jane.doe@okaxis"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "message": "Internal server error"
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "health"
        ],
        "summary": "Check the service is running",
        "responses": {
          "200": {
            "description": "The service is up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
