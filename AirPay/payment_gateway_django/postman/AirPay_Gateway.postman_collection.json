                ]
              }
            }
          ]
        },
        {
          "name": "List bank accounts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/customers/me/bank-accounts",
            "description": "Active accounts only. Full account numbers are never included."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('listed', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get bank account",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/customers/me/bank-accounts/{{bank_account_id}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('one account', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Remove bank account",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/api/v1/customers/me/bank-accounts/{{bank_account_id}}",
            "description": "Run payouts first. Removing an account does not delete payout history."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('removed', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Balance",
      "item": [
        {
          "name": "Get balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/customers/me/balance",
            "description": "`unsettled` is captured money not yet available to pay out. `settled` is available for a bank transfer."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('has both amounts', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.have.keys('currency', 'unsettled', 'settled', 'total');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Settle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/customers/me/settle",
            "description": "Pick one of your bank accounts with `bank_account_id` and how much to settle with `amount`. Omit `amount` to settle the whole unsettled balance; an amount above the unsettled balance returns 400. In production this is a T+N job.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bank_account_id\": \"{{bank_account_id}}\",\n  \"amount\": \"500.00\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('settled', function () {",
                  "  pm.response.to.have.status(200);",
