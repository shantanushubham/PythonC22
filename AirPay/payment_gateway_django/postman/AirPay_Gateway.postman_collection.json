    {
      "name": "Refunds",
      "description": "Send money back to a payer. Needs a JWT: an API key cannot refund. Run **Create card transaction** first; these use `{{transaction_id}}`.",
      "item": [
        {
          "name": "Refund part of a payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{base_url}}/api/v1/customers/me/transactions/{{transaction_id}}/refunds",
            "description": "Refunds `amount` of a successful payment. AirPay returns its commission in proportion. Comes out of unsettled first, then settled. Idempotency-Key is a new GUID each run.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"100.00\",\n  \"reason\": \"Customer returned the item\"\n}"
            }
          },
          "event": [
