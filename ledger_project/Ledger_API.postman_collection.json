    {
      "name": "Wallet",
      "description": "Wallet endpoint.\n\n- Wallets are **auto-created** when a user signs up.\n- Read-only — there is exactly one wallet per user, and balance changes only happen as a side effect of transactions (see the **Txns** folder), never via direct wallet writes.\n\n**Requires Bearer token.**",
      "item": [
        {
          "name": "Get My Wallet",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/wallet/",
              "host": ["{{base_url}}"],
              "path": ["api", "wallet", ""]
            },
            "description": "Returns the wallet belonging to the currently logged-in user. No ID needed — the wallet is resolved from the JWT.\n\n**Requires Bearer token.**"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "originalRequest": {
                "method": "GET",
                "url": { "raw": "{{base_url}}/api/wallet/" }
              },
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": 1,\n  \"user\": 1,\n  \"balance\": \"150.00\",\n  \"created_at\": \"2026-09-12T13:00:00Z\",\n  \"updated_at\": \"2026-09-12T14:00:00Z\"\n}"
            }
          ]
        }
      ]
    },
