    {
      "name": "Txns",
      "description": "Wallet transactions.\n\n- Transactions are **immutable** once created — no update or delete endpoints.\n- `id` is a UUID.\n- Exactly one of `sender_wallet` / `receiver_wallet` may be null:\n  - Load money (bank → wallet): `sender_wallet` = null, `receiver_wallet` = your wallet.\n  - Send money to bank (wallet → bank): `sender_wallet` = your wallet, `receiver_wallet` = null.\n  - Wallet → wallet transfer: both set.\n- On create, the sender's balance is checked and debited, and the receiver's balance is credited, atomically. If `sender_wallet` doesn't have sufficient balance, the request fails with 400 and nothing is changed.\n\n**All endpoints require Bearer token.**",
      "item": [
        {
          "name": "List My Txns",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/txns/",
              "host": ["{{base_url}}"],
              "path": ["api", "txns", ""]
            },
            "description": "List all transactions where the logged-in user's wallet is the sender OR the receiver."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "originalRequest": {
                "method": "GET",
                "url": { "raw": "{{base_url}}/api/txns/" }
              },
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "[\n  {\n    \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n    \"amount\": \"100.00\",\n    \"sender_wallet\": 1,\n    \"receiver_wallet\": 2,\n    \"is_success\": true,\n    \"created_at\": \"2026-09-13T18:00:00Z\"\n  }\n]"
            }
          ]
        },
        {
          "name": "Create Txn — Wallet to Wallet",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('txn_id', body.id);",
                  "    console.log('txn_id saved:', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"100.00\",\n  \"sender_wallet\": {{sender_wallet_id}},\n  \"receiver_wallet\": {{receiver_wallet_id}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/txns/",
              "host": ["{{base_url}}"],
              "path": ["api", "txns", ""]
            },
            "description": "Transfer money from one wallet to another. Both `sender_wallet` and `receiver_wallet` are set.\n\nFails with 400 if `sender_wallet` has insufficient balance."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "originalRequest": {
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": \"100.00\",\n  \"sender_wallet\": 1,\n  \"receiver_wallet\": 2\n}"
                },
                "url": { "raw": "{{base_url}}/api/txns/" }
              },
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n  \"amount\": \"100.00\",\n  \"sender_wallet\": 1,\n  \"receiver_wallet\": 2,\n  \"is_success\": true,\n  \"created_at\": \"2026-09-13T18:00:00Z\"\n}"
            },
            {
              "name": "400 Bad Request — Insufficient balance",
              "status": "Bad Request",
              "code": 400,
              "originalRequest": {
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": \"999999.00\",\n  \"sender_wallet\": 1,\n  \"receiver_wallet\": 2\n}"
                },
                "url": { "raw": "{{base_url}}/api/txns/" }
              },
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"non_field_errors\": [\"sender_wallet does not have sufficient balance for this transaction.\"]\n}"
            }
          ]
        },
        {
          "name": "Create Txn — Load Money (Bank to Wallet)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"500.00\",\n  \"receiver_wallet\": {{sender_wallet_id}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/txns/",
              "host": ["{{base_url}}"],
              "path": ["api", "txns", ""]
            },
            "description": "Load money into a wallet from a bank account. `sender_wallet` is omitted/null; `receiver_wallet` is credited. No balance check needed since there's no sender wallet."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "originalRequest": {
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": \"500.00\",\n  \"receiver_wallet\": 1\n}"
                },
                "url": { "raw": "{{base_url}}/api/txns/" }
              },
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": \"5b1c2e2a-1a2b-4c3d-9e8f-1234567890ab\",\n  \"amount\": \"500.00\",\n  \"sender_wallet\": null,\n  \"receiver_wallet\": 1,\n  \"is_success\": true,\n  \"created_at\": \"2026-09-13T18:05:00Z\"\n}"
            }
          ]
        },
        {
          "name": "Create Txn — Send to Bank (Wallet to Bank)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"200.00\",\n  \"sender_wallet\": {{sender_wallet_id}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/txns/",
              "host": ["{{base_url}}"],
              "path": ["api", "txns", ""]
            },
            "description": "Send money out of a wallet to the user's own bank account. `receiver_wallet` is omitted/null; `sender_wallet` is debited after a balance check."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "originalRequest": {
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": \"200.00\",\n  \"sender_wallet\": 1\n}"
                },
                "url": { "raw": "{{base_url}}/api/txns/" }
              },
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": \"7c2d3f3b-2b3c-4d4e-8f9a-234567890abc\",\n  \"amount\": \"200.00\",\n  \"sender_wallet\": 1,\n  \"receiver_wallet\": null,\n  \"is_success\": true,\n  \"created_at\": \"2026-09-13T18:10:00Z\"\n}"
            }
          ]
        },
        {
          "name": "Retrieve Txn",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/txns/{{txn_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "txns", "{{txn_id}}", ""]
            },
            "description": "Retrieve a single transaction by its UUID. Only visible if the logged-in user's wallet is the sender or receiver."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "originalRequest": {
                "method": "GET",
                "url": { "raw": "{{base_url}}/api/txns/3fa85f64-5717-4562-b3fc-2c963f66afa6/" }
              },
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n  \"amount\": \"100.00\",\n  \"sender_wallet\": 1,\n  \"receiver_wallet\": 2,\n  \"is_success\": true,\n  \"created_at\": \"2026-09-13T18:00:00Z\"\n}"
            }
          ]
        }
      ]
    }
  ]
