{
  "name": "payment-gateway-node",
  "version": "1.0.0",
  "description": "A mock payment gateway service built with Node.js, Express, and TypeScript. Simulates bank credit/debit transactions with a 25% random failure rate. No database - all state is kept in-memory.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["payment-gateway", "express", "typescript", "mock"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.19.2",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/uuid": "^9.0.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
